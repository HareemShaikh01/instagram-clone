# Local Postgres (created by scripts/setup-db.sh)
DATABASE_URL=postgresql://ubuntu:ubuntu@localhost:5432/instagram

# Secret used to hash session tokens before storage
SESSION_SECRET=change-me-in-production

# Where uploaded media files are stored
MEDIA_DIR=./uploads

# Limits (bytes)
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=62914560
